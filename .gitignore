

# --- [PYTHON]
# Ignore virtual environments of any kind
env/
.venv/
**/__pycache__
**/*mysql.py


# --- [DATABASE]
# Ignore database linked data folders
backend/inventory_data/*
backend/media/*
**/inventory_data/

# --- [ENVIRONMENT FILES]
# Ignore all environment files 
**/.env

# --- [FILES]
# Ignore all image files
**/*.png
**/*.jpeg

# --- [SVELTE]
app/node_modules/*
app/.svelte-kit
app/build

# --- [FLASK]
# Don't commit any session data
**/flask_session/*
