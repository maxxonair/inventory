

# --- [PYTHON]
# Ignore virtual environments of any kind
env/
.venv/
**/__pycache__


# --- [DATABASE]
# Ignore database linked data folders
database/volumes/*
database/media/*
**/volumes/
database/.env

# --- [ENVIRONMENT FILES]
# Ignore all environment files 
**/.env

# --- [FILES]
# Ignore all image files
**/*.png
**/*.jpeg

# --- [SVELTE]
app/node_modules/*
app/.svelte-kit

# --- [FLASK]
# Don't commit any session data
flask_session/*

**/*.example.py
