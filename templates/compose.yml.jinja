services:
  inventory_db:
    container_name: inventory-db
    image: "docker.io/library/mariadb:lts-noble"
    restart: unless-stopped
    ports:
      - '{{ database_port }}:3306'
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
    volumes:
      - ./backend/inventory_data/mariadb/data:/var/lib/mysql:Z
    healthcheck:
      test: [ "CMD", "mysqladmin", "ping", "-h", "localhost", "--silent" ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  inventory_server:
    image: inventoryserver:latest
    container_name: inventory-server
    restart: unless-stopped
    ports:
      - "{{ inventory_server_port }}:5000"
    volumes:
      - ./backend/media:/app/media
    environment:
      DB_HOST: inventory-db
      DB_PORT: {{ database_port }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - inventory_db

  inventory_app:
    image: inventoryapp:latest
    container_name: inventory-app
    restart: unless-stopped
    environment:
      INVENTORY_SERVER_URL: https://devmachine.lan
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.inventory_app.rule=Host(`{{ host_ip_address }}`)"
      - "traefik.http.routers.inventory_app.entrypoints=websecure"
      - "traefik.http.routers.inventory_app.tls=true"
      - "traefik.http.routers.inventory_app.tls.certresolver=selfsigned"
      - "traefik.http.services.inventory_app.loadbalancer.server.port=3000"
    ports:
      - "{{ inventoryapp_port }}:3000"

  traefik:
    image: docker.io/traefik:v3.6
    command:
      - "--configFile=/etc/traefik/traefik.yml"
    ports:
      - "8081:80"  # -> http
      - "8443:443" # -> https
    volumes:
      - "/run/user/1000/podman/podman.sock:/run/podman/podman.sock:ro" 
      - "./traefik/traefik.yml:/etc/traefik/traefik.yml:ro"
      - "./traefik/dynamic_conf.yml:/etc/traefik/dynamic_conf.yml:ro"
      - "./traefik/acme.json:/acme.json"
      - "./traefik/certs:/certs"
    restart: always

networks:
  invnet:

volumes:
  inventory_data:
    driver: local
